# Environment settings for local development.
# Copy to `.env` and fill in your own key. Never commit `.env`.

# Required: Google AI Studio API key
GOOGLE_API_KEY=

# Models
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
CHROMA_PERSIST_DIR=./chroma_db

# Generation
TEMPERATURE=0.3
TOP_P=0.9
MAX_OUTPUT_TOKENS=2048

# Backend resilience
MAX_RETRIES=3
RETRY_DELAY=1.0
RATE_LIMIT_RPM=60
CACHE_TTL=300.0
CACHE_MAX_SIZE=1000
BACKEND_URL=http://localhost:8000

# Agentic loop
AGENT_MODEL=
MAX_STEPS=5
EVIDENCE_NOTE_MAX_CHARS=800
EVIDENCE_MAX_NOTES=6
RETRIEVAL_HIT_CAP=4
RETRIEVAL_RELEVANT_MAX=0.42
RETRIEVAL_MARGINAL_MAX=0.55
AGENT_PACE_SECONDS=0

# Cost accounting (USD per 1K tokens, estimates only)
USD_PER_1K_INPUT=0.00125
USD_PER_1K_OUTPUT=0.00375

# Evaluation hook: none | tool_unavailable | malformed_retrieval | max_steps
FAILURE_INJECTION=none
