# Streamlit UI image
FROM python:3.11-slim as ui

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["streamlit", "run", "src/prod/ui.py", "--server.port=8501", "--server.address=0.0.0.0"]
