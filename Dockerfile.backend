# Backend image (FastAPI + RAG + LLM)
FROM python:3.11-slim as backend

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY docs/ ./docs/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "src.prod.backend:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
